# ── App ─────────────────────────────────────────────
APP_URL=http://localhost:3000            # production: https://<your-app>.vercel.app
HOME_CITY=Bengaluru
OWNER_NAME=Karan
ADMIN_PASSCODE=                          # optional; protects Settings > Connections & data deletion
TOKEN_ENCRYPTION_KEY=                    # 32-byte base64. Generate: openssl rand -base64 32
CRON_SECRET=                             # long random string. Generate: openssl rand -hex 32

# ── Database (Supabase) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Gemini Flash only) ──────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_CALLS_PER_RUN=12

# ── ScrapingBee ─────────────────────────────────────
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_DAILY_CREDIT_BUDGET=150

# ── Google OAuth (Gmail send + Calendar) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
ALERT_EMAIL_TO=                          # where alerts go (Karan's email)

# ── Gmail SMTP fallback (optional) ──────────────────
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# ── Optional sources ────────────────────────────────
TICKETMASTER_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback
LASTFM_API_KEY=
CONTACT_EMAIL=                           # used in MusicBrainz/Nominatim User-Agent

# ── Scan tuning ─────────────────────────────────────
SCAN_BATCH_SIZE=4
SCAN_TIME_BUDGET_MS=45000
